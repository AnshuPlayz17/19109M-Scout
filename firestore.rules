rules_version = '2';

// Only team members can read anything. Members join with the team code, which
// lives in config/secret (written by the sync job, unreadable from the app).
// Everything from RobotEvents is written by the sync job only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid)); }
    function goodNickname(n) { return n is string && n.size() > 0 && n.size() <= 24; }
    // Each named field, if present, is a string of at most `max` characters.
    function smallStrings(d, names, max) {
      return names.size() == 0 || ((!(names[0] in d) || (d[names[0]] is string && d[names[0]].size() <= max))
        && (names.size() < 2 || !(names[1] in d) || (d[names[1]] is string && d[names[1]].size() <= max))
        && (names.size() < 3 || !(names[2] in d) || (d[names[2]] is string && d[names[2]].size() <= max))
        && (names.size() < 4 || !(names[3] in d) || (d[names[3]] is string && d[names[3]].size() <= max))
        && (names.size() < 5 || !(names[4] in d) || (d[names[4]] is string && d[names[4]].size() <= max)));
    }
    // Admins are listed by account id in meta/admins (the sync fills it from the ADMIN_EMAILS secret).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/meta/admins)
        && request.auth.uid in get(/databases/$(database)/documents/meta/admins).data.uids;
    }

    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'code', 'joinedAt'])
        && goodNickname(request.resource.data.nickname)
        && request.resource.data.code == get(/databases/$(database)/documents/config/secret).data.code;
      allow update: if isMember() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
        && goodNickname(request.resource.data.nickname);
    }

    match /scouting/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['team', 'event', 'match', 'autoPins', 'auto', 'rating', 'notes', 'by', 'nickname', 'at', 'game',
             'drive', 'autoSide', 'endgame', 'defense', 'driver', 'reliable', 'tags'])
        && smallStrings(request.resource.data, ['drive', 'autoSide', 'endgame', 'reliable'], 30)
        && (!('defense' in request.resource.data) || (request.resource.data.defense is int && request.resource.data.defense >= 0 && request.resource.data.defense <= 3))
        && (!('driver' in request.resource.data) || (request.resource.data.driver is int && request.resource.data.driver >= 0 && request.resource.data.driver <= 5))
        && (!('tags' in request.resource.data) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 12))
        && (!('game' in request.resource.data) || request.resource.data.game in ['override', 'pushback'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.team is string && request.resource.data.team.size() <= 12
        && request.resource.data.event is string && request.resource.data.event.size() <= 20
        && request.resource.data.match is string && request.resource.data.match.size() <= 20
        && request.resource.data.autoPins is int && request.resource.data.autoPins >= 0 && request.resource.data.autoPins <= 30
        && request.resource.data.auto is string && request.resource.data.auto.size() <= 40
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
        && goodNickname(request.resource.data.nickname);
      allow delete: if isMember() && resource.data.by == request.auth.uid;
    }

    // "Load this event" / "Refresh" buttons; the sync job picks these up.
    match /requests/{id} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['kind', 'key', 'by', 'at', 'game'])
        && (!('game' in request.resource.data) || request.resource.data.game in ['override', 'pushback'])
        && request.resource.data.kind in ['team', 'event']
        && request.resource.data.key is string && request.resource.data.key.size() <= 20
        && request.resource.data.by == request.auth.uid;
    }

    // Shared checklists: any member can tick, edit, add or delete lists.
    match /checklists/{id} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['name', 'order', 'items', 'done', 'by', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.items is list && request.resource.data.items.size() <= 80
        && request.resource.data.done is map
        && request.resource.data.by == request.auth.uid;
    }

    match /meta/{d} { allow read: if isMember(); }

    // Pit scouting: one shared sheet per team per game ("2088A__override"), anyone can update it.
    match /pits/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['team', 'game', 'drive', 'motors', 'intake', 'scoring', 'endgame', 'autos', 'strategy', 'notes', 'by', 'nickname', 'at'])
        && request.resource.data.by == request.auth.uid && goodNickname(request.resource.data.nickname)
        && request.resource.data.team is string && request.resource.data.team.size() <= 12
        && request.resource.data.game in ['override', 'pushback']
        && smallStrings(request.resource.data, ['drive', 'motors'], 60)
        && smallStrings(request.resource.data, ['intake', 'scoring', 'endgame', 'autos', 'strategy'], 300)
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000;
    }

    // Notes on our own matches (what went right, what went wrong, what to change), one per match.
    match /matchNotes/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['event', 'match', 'name', 'teams', 'game', 'good', 'bad', 'next', 'by', 'nickname', 'at'])
        && request.resource.data.by == request.auth.uid && goodNickname(request.resource.data.nickname)
        && request.resource.data.game in ['override', 'pushback']
        && request.resource.data.teams is list && request.resource.data.teams.size() <= 6
        && smallStrings(request.resource.data, ['event', 'match', 'name'], 40)
        && smallStrings(request.resource.data, ['good', 'bad'], 800)
        && smallStrings(request.resource.data, ['next'], 400);
      allow delete: if isMember() && resource.data.by == request.auth.uid;
    }

    // AI jobs: a chat question or a "Scout for me" report, answered by the sync job (which also
    // keeps to the daily spending cap). Each person sees only their own.
    match /aiJobs/{id} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['kind', 'by', 'nickname', 'at', 'game', 'status', 'messages', 'open', 'event', 'match'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.game in ['override', 'pushback']
        && goodNickname(request.resource.data.nickname)
        && ((request.resource.data.kind == 'chat' && request.resource.data.messages is list && request.resource.data.messages.size() <= 12)
          || (request.resource.data.kind == 'report' && request.resource.data.event is string && request.resource.data.event.size() <= 12)
          || (request.resource.data.kind == 'review' && request.resource.data.event is string && request.resource.data.event.size() <= 12)
          || (request.resource.data.kind == 'plan' && request.resource.data.event is string && request.resource.data.event.size() <= 12
            && request.resource.data.match is string && request.resource.data.match.size() <= 20));
      allow read, delete: if isMember() && resource.data.by == request.auth.uid;
    }
    // Scout for me reports and match game plans (written by the sync), shared with the whole team.
    match /reports/{d} { allow read: if isMember(); }
    match /plans/{d} { allow read: if isMember(); }
    match /reviews/{d} { allow read: if isMember(); }

    // Skills runs we log ourselves (practice, or ones not on VEX Events yet), for the skills planner.
    match /skillsRuns/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['kind', 'score', 'date', 'notes', 'game', 'by', 'nickname', 'at'])
        && request.resource.data.kind in ['driver', 'prog']
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 999
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 200
        && request.resource.data.game in ['override', 'pushback']
        && request.resource.data.by == request.auth.uid && goodNickname(request.resource.data.nickname);
      allow delete: if isMember() && resource.data.by == request.auth.uid;
    }

    // Alliance selection: which teams are already taken, live for everyone ("override-5002").
    match /selection/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['taken', 'by', 'nickname', 'at'])
        && request.resource.data.taken is list && request.resource.data.taken.size() <= 200
        && request.resource.data.by == request.auth.uid && goodNickname(request.resource.data.nickname);
    }

    // Scouting assignments for an event: who scouts which teams ("override-5002").
    match /assignments/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['scouts', 'teams', 'by', 'nickname', 'at'])
        && request.resource.data.scouts is list && request.resource.data.scouts.size() <= 40
        && request.resource.data.teams is map && request.resource.data.teams.size() <= 300
        && request.resource.data.by == request.auth.uid && goodNickname(request.resource.data.nickname);
      allow delete: if isMember();
    }

    // Phones that want "Queue now" notifications (Web Push). Each person manages their own.
    match /pushSubs/{id} {
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['by', 'endpoint', 'p256dh', 'auth', 'at'])
        && request.resource.data.by == request.auth.uid
        && (resource == null || resource.data.by == request.auth.uid)
        && request.resource.data.endpoint is string && request.resource.data.endpoint.size() < 1000
        && request.resource.data.p256dh is string && request.resource.data.p256dh.size() < 200
        && request.resource.data.auth is string && request.resource.data.auth.size() < 100;
      allow read, delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // "Forgot the team code? Ask an admin": anyone signed in (members, and people stuck at the
    // join screen) can ask; only admins see the requests. One request per account.
    match /codeRequests/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'email', 'where', 'at'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 24
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.where is string && request.resource.data.where.size() <= 40;
      allow read, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    // The team code itself: admins can read it in the app so they can pass it on.
    match /config/secret { allow read: if isAdmin(); }
    match /events/{d} { allow read: if isMember(); }
    match /index/{d} { allow read: if isMember(); }
    match /teamstats/{d} { allow read: if isMember(); }
    match /notes/{d} { allow read: if isMember(); }
    match /autos/{d} { allow read: if isMember(); }
  }
}
