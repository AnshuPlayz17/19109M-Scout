{
  "hosting": {
    "public": "web",
    "ignore": ["firebase-config.example.js"],
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "no-cache" }
      ] },
      { "source": "**/*.webp", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
